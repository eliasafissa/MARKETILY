APP_NAME="Marketly"
APP_ENV=local
APP_KEY=
# ⚠️ Set to false in production — never expose debug info to end users
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# For local development: MySQL via Docker or ServBay
#   DB_HOST=127.0.0.1  DB_PORT=3306
# For Railway: use the internal Railway MySQL hostname from the Railway dashboard
#   DB_HOST=railway-internal-hostname  DB_PORT=3306
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketly
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions & Cache
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use the `database` cache store for portability (works on Railway without
# a Redis add-on). Once a Redis add-on is provisioned, switch to `redis`
# for a small performance bump:
#   CACHE_STORE=redis
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Filesystem / Storage
# ---------------------------------------------------------------------------
# local  = disk files stored in storage/app/public (good for dev)
# public = persistent disk for production (mount a Railway Volume at storage/app/public)
#
# For Railway Persistent Volume:
#   1. In Railway dashboard, add a Persistent Volume to the backend service
#   2. Mount it at: /app/storage/app/public
#   3. Set FILESYSTEM_DISK=public
#
# Also ensure storage_link is run on deploy:
#   php artisan storage:link
FILESYSTEM_DISK=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# For Railway: use the internal Railway Redis hostname
#   REDIS_HOST=railway-internal-redis-hostname  REDIS_PORT=6379
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Broadcast: Reverb (WebSockets)
# ---------------------------------------------------------------------------
# For Railway internal networking, use the Railway-provided internal hostname.
# Example Railway service reference: ${{ .Railway.Redis.HOST }}
# BROADCAST_CONNECTION=reverb
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
BROADCAST_CONNECTION=log

REVERB_APP_ID=marketly
REVERB_APP_KEY=marketly-key
REVERB_APP_SECRET=marketly-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Payment Gateways
# ---------------------------------------------------------------------------
# ⚠️ Replace these with real production keys when ready
BINANCE_PAY_KEY=MOCK_BINANCE_KEY
BINANCE_PAY_SECRET=MOCK_BINANCE_SECRET
USDT_WALLET_ADDRESS=0xMOCKUSDTWALLETADDRESS
USDT_WEBHOOK_SECRET=MOCK_USDT_SECRET

ORANOS_API_URL=https://api.oranosmarket.com
ORANOS_API_TOKEN=
ORANOS_MARKUP=1.20

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# For local development / staging: use MAIL_MAILER=log
#   All emails are written to storage/logs/laravel.log for inspection.
#
# For real email, set up a free Mailtrap account (https://mailtrap.io):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<your mailtrap username>
#   MAIL_PASSWORD=<your mailtrap password>
#   MAIL_FROM_ADDRESS="noreply@marketly.com"
#   MAIL_FROM_NAME="Marketly"
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Frontend / Vite
# ---------------------------------------------------------------------------
VITE_APP_NAME="Marketly"
VITE_API_URL=http://localhost:8000/api
# For production, set VITE_API_URL=https://marketly-production.up.railway.app/api

# Reverb client settings (exported to window)
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_APP_KEY=marketly-key

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Google Analytics 4: paste your Measurement ID (G-XXXXXXXXXX)
# Leave empty to disable tracking in development
VITE_GA_MEASUREMENT_ID=
# Umami (privacy-friendly alternative): paste your Umami website ID
VITE_UMAMI_WEBSITE_ID=
